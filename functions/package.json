{
  "name": "acadegate-functions",
  "description": "Cloud Functions for AcadeGate AI",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
