rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // General uploads: owner-only. More specific paths below override by OR —
    // keep reads owner-scoped on every match so advisor/viva never leak.
    match /uploads/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*')
                   && request.resource.name.matches('.*\\.(png|jpe?g|webp|gif)$');
    }

    // مرفقات الشات — أي مستخدم مسجّل يمكنه القراءة (الرابط يُشارك داخل الرسالة)
    match /uploads/{userId}/chat/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 40 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('video/.*')
                       || request.resource.contentType.matches('audio/.*')
                       || request.resource.contentType.matches('application/.*')
                       || request.resource.contentType.matches('text/.*'));
    }

    // مرفقات ردود المجتمع: صور وPDF فقط، حتى 5 ميجا. مسار منفصل عن uploads/
    // لأن قاعدة uploads العامة تسمح بصور حتى 15 ميجا تحت أي مسار فرعي.
    match /community_uploads/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size > 0
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/png|image/jpeg|image/webp|image/gif|application/pdf')
                   && fileName.matches('[A-Za-z0-9-]+\\.(png|jpe?g|webp|gif|pdf)');
    }

    match /uploads/{userId}/claims/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 15 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf')
                   && request.resource.name.matches('.*\\.(png|jpe?g|webp|pdf)$');
    }

    // صور منتجات المتجر — قراءة عامة للعرض في الكتالوج
    match /uploads/{userId}/products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 40 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'video/mp4')
                   && request.resource.name.matches('.*\\.(png|jpe?g|webp|gif|mp4)$');
    }

    // أصول معرفية مشفّرة — البائع أو حامل ترخيص نشط فقط
    match /knowledge_assets/{sellerId}/{productId}/{fileName} {
      allow write: if request.auth != null
                   && request.auth.uid == sellerId
                   && request.resource.size < 40 * 1024 * 1024
                   && (request.resource.contentType.matches('application/pdf')
                       || request.resource.contentType.matches('application/zip')
                       || request.resource.contentType.matches('application/octet-stream')
                       || request.resource.contentType.matches('application/msword')
                       || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*')
                       || request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('video/.*')
                       || request.resource.contentType.matches('audio/.*')
                       || request.resource.contentType.matches('text/.*'));
      allow read: if request.auth != null && (
        request.auth.uid == sellerId
        || (
          firestore.exists(
            /databases/(default)/documents/product_licenses/$(request.auth.uid + '_' + productId)
          )
          && firestore.get(
            /databases/(default)/documents/product_licenses/$(request.auth.uid + '_' + productId)
          ).data.status == 'active'
          && (
            !('expiresAt' in firestore.get(
              /databases/(default)/documents/product_licenses/$(request.auth.uid + '_' + productId)
            ).data)
            || firestore.get(
              /databases/(default)/documents/product_licenses/$(request.auth.uid + '_' + productId)
            ).data.expiresAt == null
            || firestore.get(
              /databases/(default)/documents/product_licenses/$(request.auth.uid + '_' + productId)
            ).data.expiresAt > request.time
          )
        )
      );
    }

    match /uploads/{userId}/advisor/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/png|image/jpeg|image/webp|application/pdf|application/vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document|application/vnd\\.openxmlformats-officedocument\\.spreadsheetml\\.sheet|application/vnd\\.openxmlformats-officedocument\\.presentationml\\.presentation|application/msword|application/vnd\\.ms-excel|application/vnd\\.ms-powerpoint|text/plain|text/markdown|text/csv|text/tab-separated-values')
                   && request.resource.name.matches('(?i).*\\.(png|jpe?g|webp|pdf|docx?|xlsx?|pptx?|txt|md|csv|tsv)$');
    }

    match /uploads/{userId}/viva/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 40 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf'
                   && request.resource.name.matches('.*\\.pdf$');
    }

    // فصول المنهجية (PDF) — فحص سلامة المنهجية
    match /uploads/{userId}/methodology/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 40 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf'
                   && request.resource.name.matches('.*\\.pdf$');
    }

    // ملفات CAD (STEP/STL) من PartWork / ty\e — للتوافق المخصص
    match /uploads/{userId}/cad/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 40 * 1024 * 1024
                   && (request.resource.contentType == 'application/step'
                       || request.resource.contentType == 'model/stl'
                       || request.resource.contentType == 'application/sla'
                       || request.resource.contentType == 'application/octet-stream');
    }

    match /publish/{userId}/{manuscriptId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 24 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('application/pdf')
                       || request.resource.contentType.matches('application/msword')
                       || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.wordprocessingml.document'));
    }
  }
}
